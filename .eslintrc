{
  "extends": [
    "airbnb"
  ],
  "rules": {
    "camelcase": [
      "error",
      {
        "allow": ["^unstable_"]
      }
    ],
    "no-unused-vars": [
      2,
      {
        "args": "all",
        "argsIgnorePattern": "^_"
      }
    ],
    "no-warning-comments": 0,
    "max-len": ["error", { "code": 120 }],
    "comma-dangle": ["error", "only-multiline"],
    "implicit-arrow-linebreak": "off",
    "no-confusing-arrow": "off",
    "function-paren-newline": "off",
    "space-before-function-paren": 0,
    "func-names": 0,
    // Relative imports must carry their file extension: this package ships both a
    // CommonJS and an ES module entry point, and Node's ESM resolver requires them.
    "import/extensions": ["error", "ignorePackages"],
    "semi": [1, "always"] // 1 is for warning
  },
  "parserOptions": {
    // 2020 or later is required to parse `import.meta` in tailwind.config.mjs.
    "ecmaVersion": 2020,
    "sourceType": "module"
  },
  "settings": {
    "react": {
      "version": "999.999.999"
    }
  }
}
