{
  "name": "decanter",
  "description": "Stanford University's design system as a CSS-first Tailwind CSS v4 preset: color palette, typography, spacing, components, and utilities.",
  "author": "Stanford Web Services",
  "version": "8.0.0-beta.2",
  "homepage": "https://github.com/SU-SWS/decanter",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "CSS",
    "Decanter",
    "Stanford",
    "TailwindCSS",
    "Tailwind CSS",
    "Tailwind CSS v4",
    "Design System"
  ],
  "main": "src/css/index.css",
  "style": "src/css/index.css",
  "exports": {
    ".": "./src/css/index.css",
    "./minimal": "./src/css/index-minimal.css",
    "./base16": "./src/css/index-base16.css",
    "./base16/minimal": "./src/css/index-base16-minimal.css",
    "./colors": "./src/css/theme/colors.css",
    "./forms": "./src/css/forms.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/css",
    "docs",
    "README.md",
    "UPGRADE.md",
    "license.md"
  ],
  "scripts": {
    "build": "npm run build:base10 && npm run build:base16",
    "build:base10": "tailwindcss -i dev/dev.css -o static/css/decanter.css",
    "build:base16": "tailwindcss -i dev/dev-base16.css -o static/css/decanter-base16.css",
    "watch": "concurrently --names base10,base16 --prefix-colors cyan,magenta \"npm:watch:base10\" \"npm:watch:base16\"",
    "watch:base10": "tailwindcss -i dev/dev.css -o static/css/decanter.css --watch=always",
    "watch:base16": "tailwindcss -i dev/dev-base16.css -o static/css/decanter-base16.css --watch=always",
    "serve": "serve static -l 4000",
    "dev": "concurrently --names css,web --prefix-colors cyan,green \"npm:watch\" \"npm:serve\"",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SU-SWS/decanter.git"
  },
  "bugs": {
    "url": "https://github.com/SU-SWS/decanter/issues"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.16"
  },
  "dependencies": {
    "@tailwindcss/forms": "^0.5.11"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "auto-changelog": "^2.6.0",
    "concurrently": "^10.0.3",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
