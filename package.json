{
  "name": "decanter",
  "description": "Design System TailwindCSS Preset.",
  "author": "Stanford Web Services",
  "version": "7.4.0",
  "homepage": "https://github.com/SU-SWS/decanter",
  "license": "GPL-3.0-or-later",
  "keywords": [
    "CSS",
    "Decanter",
    "Stanford",
    "TailwindCSS"
  ],
  "main": "src/css/index.css",
  "style": "src/css/index.css",
  "exports": {
    ".": "./src/css/index.css",
    "./minimal": "./src/css/index-minimal.css",
    "./colors": "./src/css/theme/colors.css",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "src/css",
    "README.md",
    "license.md"
  ],
  "scripts": {
    "build": "tailwindcss -i dev/dev.css -o static/css/decanter.css",
    "watch": "tailwindcss -i dev/dev.css -o static/css/decanter.css --watch",
    "serve": "light-server -s static -w \"static/*.html,static/css/*.css\"",
    "dev": "concurrently \"npm:serve\" \"npm:watch\"",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SU-SWS/decanter.git"
  },
  "bugs": {
    "url": "https://github.com/SU-SWS/decanter/issues"
  },
  "peerDependencies": {
    "tailwindcss": "^4.1.16"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "@tailwindcss/forms": "^0.5.11",
    "auto-changelog": "^2.6.0",
    "concurrently": "^10.0.3",
    "light-server": "^2.9.1",
    "tailwindcss": "^4.3.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
